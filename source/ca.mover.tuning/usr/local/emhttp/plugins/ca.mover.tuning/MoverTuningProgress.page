<?php
// Progress rows and the Pause button under the Move button on Main, and by Move now on the Mover Tuning tab (7.2.1 and later).
// From Unraid 7.4 Main has its own rows, which age_mover's status file feeds, so Main gets the rows only before 7.4.
$moverTuningProgressPage = $myPage['name'] ?? '';
$moverTuningProgressOn = $moverTuningProgressPage === 'Scheduler' || $moverTuningProgressPage === 'Main';
$moverTuningRowsOn = $moverTuningProgressPage === 'Scheduler' || ($moverTuningProgressPage === 'Main' && version_compare(preg_replace('/-.*/', '', $var['version'] ?? ''), '7.4', '<') === true);
if ($moverTuningProgressOn === true) {
  // only this plugin's strings, so Main keeps Unraid's own translations
  $moverTuningUnraidLanguage = $language;
  $moverTuningPack = "$docroot/plugins/ca.mover.tuning/languages/$locale.txt";
  $language = preg_match('/^[a-z]{2}_[A-Z]{2}$/', $locale ?? '') === 1 && file_exists($moverTuningPack) === true ? parse_lang_file($moverTuningPack) : [];
  $moverTuningProgressText = [
    'titles' => [_('File being processed'), _('Action'), _('Overall Progress'), _('Estimated Completion')],
    'eta' => _('ETA'),
    'speed' => _('Speed'),
    'unknown' => _('Unknown'),
    'complete' => _('Transfer complete'),
    'pause' => _('Pause'),
    'resume' => _('Resume'),
    'pauseHint' => _('Pause moving files until Resume, the next scheduled run or a cache watchdog trigger'),
  ];
  $language = $moverTuningUnraidLanguage;
}
?>
<?if ($moverTuningProgressOn === true):?>
<script>
$(function() {
  const text = <?=json_encode($moverTuningProgressText)?>;
  const onMain = <?=json_encode($moverTuningProgressPage === 'Main')?>;
  const move = onMain ? $('input[name="cmdStartMover"]').first() : $('#StartTuneMoverBtn');
  if (move.length === 0) return;
  // Main: the table row of the Move button (the same on 6.9 to 7.4); the tab: the list that holds Move now
  const anchor = onMain ? move.closest('tr') : move.closest('dl');
  // shown and hidden by style: Unraid's own styles (dl {display:grid} from 7.3, its buttons) override the hidden attribute
  const rows = <?=json_encode($moverTuningRowsOn)?> ? text.titles.map(title => {
    const row = $(onMain ? '<tr><td></td><td></td><td></td></tr>' : '<dl><dt></dt><dd></dd></dl>').hide();
    row.children().eq(onMain ? 1 : 0).html(title + ':');
    return row;
  }) : [];
  anchor.after(rows.map(row => row[0]));
  const value = i => rows[i].children().last();
  // Main: half the cell, as on 7.4; the tab: as wide as its dropdowns, which each release sizes differently
  const barWidth = () => onMain ? '50%' : ($('#StartTuneMoverBtn').closest('form').find('select:visible').first().outerWidth() || 300) + 'px';
  const pause = $(onMain ? '<input type="button">' : '<button type="button" class="button"></button>').hide();
  move.after(pause);
  let sending = false;
  let running = false;

  // as Unraid 7.4's parity_list shows them: h:mm:ss, and one decimal in units of 1000
  function duration(seconds) {
    if (seconds <= 0) return text.unknown;
    const h = Math.floor(seconds / 3600), m = Math.floor(seconds % 3600 / 60), s = seconds % 60;
    return (h > 0 ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(s).padStart(2, '0');
  }
  function speed(bytes) {
    if (bytes <= 0) return text.unknown;
    const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    const base = Math.min(Math.floor(Math.log(bytes) / Math.log(1000)), units.length - 1);
    return (bytes / Math.pow(1000, base)).toFixed(1) + ' ' + units[base] + '/sec';
  }

  // null when no run with progress is going on; Unraid's mover writes its own action, so a held run of it says Paused here
  function showRows(progress, paused) {
    if (rows.length === 0) return;
    rows.forEach(row => row.toggle(progress !== null));
    if (progress === null) return;
    value(0).text(progress.file);
    value(1).text(paused === true ? 'Paused' : progress.action);
    // while the run is planned there is nothing to measure yet
    rows[2].toggle(progress.total > 0);
    rows[3].toggle(progress.total > 0);
    if (progress.remain > 0) {
      const percent = Math.min(100, Math.max(0, Math.round((progress.total - progress.remain) / progress.total * 10000) / 100));
      // centred here: Unraid's label offset (top:-0.4rem from 7.x) only lines up inside Main's table cells
      value(2).html("<div class='usage-disk' style='width:" + barWidth() + ";display:flex;align-items:center'><span style='width:" + percent + "%' class='greenbar'></span><span style='top:0'>" + percent + "%</span></div>");
    } else {
      value(2).html(text.complete);
    }
    value(3).text(text.eta + ': ' + duration(progress.eta) + ' • ' + text.speed + ': ' + speed(progress.speed));
  }

  // only while moverProgress.php says the run can be paused: a Mover Tuning run's planning and its steps after the moves
  // cannot, nor can a run Unraid started itself
  function showPause(reply) {
    const moving = reply !== null && reply.moving === true;
    pause.toggle(moving);
    if (moving === false) return;
    const action = reply.paused === true ? 'resume' : 'pause';
    pause.data('action', action).prop('disabled', sending).attr('title', action === 'pause' ? text.pauseHint : '');
    if (onMain === true) {
      pause.val(text[action]);
    } else {
      pause.empty().append($('<i>').addClass(action === 'pause' ? 'fa fa-pause' : 'fa fa-play'), document.createTextNode(' ' + text[action]));
    }
  }

  // null when no run is going on
  function show(reply) {
    running = reply !== null;
    showRows(running === true ? reply.progress : null, running === true && reply.paused === true);
    showPause(reply);
  }

  pause.on('click', () => {
    sending = true;
    pause.prop('disabled', true);
    $.post('/plugins/ca.mover.tuning/moverPause.php', {action: pause.data('action')}).always(() => { sending = false; });
  });

  function poll() {
    if (document.hidden === true) {
      setTimeout(poll, 5000);
      return;
    }
    $.getJSON('/plugins/ca.mover.tuning/moverProgress.php', {_: Date.now()})
      .done(show)
      .fail(() => show(null))
      .always(() => setTimeout(poll, running === true ? 2000 : 5000));
  }
  poll();
});
</script>
<?endif;?>
