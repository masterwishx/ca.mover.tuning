	MoveShare.disabled = true;
}

// A setting on No or Use global leaves the fields that belong to it unused.
function mtDepends(sel, value) {
  $(sel).prop('disabled', value !== 'yes');
}

function mtAgeFields() {
  var age = $('select[name="age"]').val() === 'yes';
  $('select[name="daysold"]').prop('disabled', !age);
  $('select[name="ctime"]').prop('disabled', !age || $('select[name="atime"]').val() === 'yes');
  $('select[name="atime"]').prop('disabled', !age || $('select[name="ctime"]').val() === 'yes');
}

function mtMoveAllChanged(value) {
  mtDepends('.myomthresh', value);
  mtRebuildThresholds($('select[name="movingThreshold"]').val());
}

// What the config holds, before the selects below capped it to a range; null is Use global.
var mtSaved = {
  moving:   <?=strlen((string)($cfg['movingThreshold'] ?? '')) > 0 ? (int)$cfg['movingThreshold'] : 'null'?>,
  freeing:  <?=strlen((string)($cfg['freeingThreshold'] ?? '')) > 0 ? (int)$cfg['freeingThreshold'] : 'null'?>,
  omover:   <?=strlen((string)($cfg['omoverthresh'] ?? '')) > 0 ? (int)$cfg['omoverthresh'] : 'null'?>,
  omoverOn: <?=strlen((string)($cfg['omovercfg'] ?? '')) > 0 ? json_encode(($cfg['omovercfg'] ?? '') === 'yes') : 'null'?>
};
// The global values a setting on Use global follows.
var mtGlobal = {
  moving:   <?=(int)($globalCfg['movingThreshold'] ?? 0)?>,
  freeing:  <?=(int)($globalCfg['freeingThreshold'] ?? 0)?>,
  omover:   <?=strlen((string)($globalCfg['omoverthresh'] ?? '')) > 0 ? (int)$globalCfg['omoverthresh'] : 'null'?>,
  omoverOn: <?=json_encode(($globalCfg['omovercfg'] ?? '') === 'yes')?>
};
// Saved values of the selects with a fixed list; one the list does not offer is kept as its own option.
var mtSavedLists = <?=json_encode(['daysold' => (string)($cfg['daysold'] ?? ''), 'sizeinM' => (string)($cfg['sizeinM'] ?? ''), 'sizeinMSync' => (string)($cfg['sizeinMSync'] ?? ''), 'sparsnessv' => (string)($cfg['sparsnessv'] ?? ''), 'fillupThreshold' => (string)($cfg['fillupThreshold'] ?? ''), 'movingThreshold' => (string)($cfg['movingThreshold'] ?? '')], JSON_HEX_TAG)?>;

// Refills one select over [from..to], after its Use global option. Returns '' when the current value
// survived, else the value it was clamped to.
function mtFillRange(sel, from, to, step) {
  var $sel = $(sel);
  if (!$sel.length) return '';
  if (step > 0 && from > to) from = to;
  if (step < 0 && from < to) from = to;
  var $global = $sel.find('option[value=""]');
  var prev = $sel.val(), html = $global.length ? $global.prop('outerHTML') : '', keep = $global.length > 0 && prev === '';
  for (var v = from; step > 0 ? v <= to : v >= to; v += step) {
    html += '<option value="' + v + '">' + v + ' %</option>';
    if (String(v) === prev) keep = true;
  }
  $sel.html(html);
  $sel.val(keep ? prev : String(from));
  return keep ? '' : $sel.val();
}

// %1, %2... in a translated template are filled from the extra arguments.
function mtFmt(tpl) {
  var args = arguments;
  return tpl.replace(/%(\d)/g, function(m, i) { return args[i]; });
}

function mtNotice(id, text) {
  var $n = $(id);
  if (!$n.length) return;
  if (text) $n.html('<i class="fa fa-warning"></i> ' + text).show(); else $n.hide();
}

// Both ranges are derived from the moving threshold in effect, so a range left over from an older
// moving value would save a number nobody picked.
function mtRebuildThresholds(moving) {
  var own = moving !== '';
  moving = own ? (parseInt(moving, 10) || 0) : mtGlobal.moving;

  var $fr = $('select[name="freeingThreshold"]');
  var freeing = mtFillRange($fr, moving, 0, -5);
  // Use global follows the global value, which must also fit under this share's own moving threshold
  if (own && $fr.val() === '' && mtGlobal.freeing > moving) freeing = $fr.val(String(moving)).val();
  mtNotice('#freeing_notice', freeing ?
    mtFmt('_(Freeing threshold lowered to %1 to stay at or below the moving threshold.)_', freeing + '%') : '');

  var $om = $('select[name="omoverthresh"]');
  var omover = mtFillRange($om, moving + 5, 100, 5), note = '_(Move All threshold raised to %1 to stay above the moving threshold.)_';
  // Move All on with its percentage on Use global needs a global percentage, above this share's own moving threshold
  if (!$om.prop('disabled') && $om.val() === '' && mtGlobal.omover === null) {
    omover = $om.val(String(moving + 5)).val();
    note = '_(Move All threshold set to %1, as the global settings have none.)_';
  } else if (own && !$om.prop('disabled') && $om.val() === '' && mtGlobal.omover <= moving) {
    omover = $om.val(String(moving + 5)).val();
  }
  note = (omover && !$om.prop('disabled')) ? mtFmt(note, omover + '%') : '';
  // Move All on Use global follows the global one, which this page cannot raise
  if (!note && $('select[name="omovercfg"]').val() === '' && mtGlobal.omoverOn && mtGlobal.omover !== null && mtGlobal.omover <= moving) {
    note = mtFmt('_(The global Move All threshold of %1 is at or below the moving threshold of this share, %2, so everything on this share moves from %1.)_', mtGlobal.omover + '%', moving + '%');
  }
  mtNotice('#omoverthresh_notice', note);
}

// A config saved before the ranges tracked each other can hold a combination this page cannot
// show, so it would display one value and store another until the next save.
function mtWarnSavedThresholds() {
  var moving = mtSaved.moving === null ? mtGlobal.moving : mtSaved.moving;
  var freeing = mtSaved.freeing === null ? mtGlobal.freeing : mtSaved.freeing;
  var omover = mtSaved.omover === null ? mtGlobal.omover : mtSaved.omover;
  var $fr = $('select[name="freeingThreshold"]'), $om = $('select[name="omoverthresh"]');
  // only where this page now shows another value than the saved one (Use global is saved empty)
  var changed = function($sel, saved) { return $sel.val() !== (saved === null ? '' : String(saved)); };
  var msgs = [];
  if (freeing > moving && changed($fr, mtSaved.freeing)) {
    msgs.push(mtFmt('_(The saved freeing threshold is %1, above the moving threshold of %2. The mover starts at %2 and stops at %1, so nothing is moved while the pool sits between them. This page now shows %3, and saving will store that.)_',
      freeing + '%', moving + '%', $fr.val() + '%'));
  }
  if (mtSaved.omoverOn === true && omover !== null && omover <= moving && changed($om, mtSaved.omover)) {
    msgs.push(mtFmt('_(The saved Move All threshold is %1, at or below the moving threshold of %2. Everything on cache:yes shares moves, skip list and filters ignored, before the moving threshold is reached. This page now shows %3, and saving will store that.)_',
      omover + '%', moving + '%', $om.val() + '%'));
  }
  if (!msgs.length) return;
  if (typeof swal === 'function') {
    swal({title: '_(Mover Tuning thresholds)_', text: msgs.join('\n\n'), type: 'warning', confirmButtonText: '_(OK)_'});
  } else {
    mtNotice('#freeing_notice', msgs.join(' '));
  }
}

function updateScreenMoverTuning(option,slow) {
  switch (option) {
  case 'no':
    $('#moverSettings').hide(slow);
    break;
  case 'yes':
    $('#moverSettings').show(slow);
    break;
  }
}
$(function() {
  updateScreenMoverTuning('<? echo $overrideEnabled ?>');

  // otherwise the browser would show Use global, and Apply would store that
  $.each(mtSavedLists, function(name, value) {
    var $sel = $('select[name="' + name + '"]');
    if (value === '' || !$sel.length || $sel.find('option').filter(function() { return this.value === value; }).length) return;
    $sel.append($('<option>').val(value).text(/Threshold$/.test(name) ? value + ' %' : value)).val(value);
  });

  // the share page omits these selects for cache:prefer and unavailable shares
  var $moving = $('select[name="movingThreshold"]');
  if ($moving.length) {
    // a saved value outside the drawn range selects no option, and the browser would show Use global instead
    if (mtSaved.freeing !== null) $('select[name="freeingThreshold"]').val(String(mtSaved.freeing));
    if (mtSaved.omover !== null) $('select[name="omoverthresh"]').val(String(mtSaved.omover));
    mtRebuildThresholds($moving.val());
    mtWarnSavedThresholds();
  }
});
</script>

