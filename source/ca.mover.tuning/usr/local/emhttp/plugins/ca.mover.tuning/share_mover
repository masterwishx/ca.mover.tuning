#!/bin/bash

# Unraid 7.4 knows a running mover by a "mover" word in its command line (sbin/mover is_mover_pid, nchan/parity_list):
# run as "mover <this script> <share>", which keeps this path in the command line
read -r -d '' mt_argv0 </proc/$$/cmdline
[ "$mt_argv0" = mover ] || exec -a mover /bin/bash "$0" "$@"

PIDFILE="/var/run/mover.pid"
UNRAIDCFGFILE="/boot/config/share.cfg"
MOVERTUNINGCFGFILE="/boot/config/plugins/ca.mover.tuning/ca.mover.tuning.cfg"
LOGLEVEL=0

# Wraps a path for a log message: the debug package ends a path at the quote, so an
# embedded quote - an edge case, but the last redaction hole - would expose the rest.
qp() { local p=${1//\\/\\\\}; printf '"%s"' "${p//\"/\\\"}"; }

# Function for verbose output and logging
mvlogger() {
    if [ $LOGLEVEL = 1 ]; then
        echo "$(date +"%b %e %H:%M:%S") Share mover: $1"
    fi
}

function titleLine() {
    local title="$1"
    local padding_char="$2"
    local line_length=71
    local padding_left=$((line_length - ${#title} / 2))
    local padding_right=$((padding_left - ${#title} % 2 - 1))
    local left_padding right_padding
    left_padding=$(printf "%*s" "$padding_left" "" | tr ' ' "$padding_char")
    right_padding=$(printf "%*s" "$padding_right" "" | tr ' ' "$padding_char")
    echo "${left_padding}$padding_char $title $padding_char${right_padding}"
}

#Moved variable assignment into a function

getMoverSettings() {
    #Use the config file instead of input variables (ease execution from command line)
    local config_file="$1"
    cfg() {
        local param="$1"
        local value
        while IFS='=' read -r key val; do
            [ "$key" == "$param" ] && {
                value="$val"
                break
            }
        done <"$config_file"
        echo "${value//\"/}" # Print value or empty string if not found, without quotes
    }
    # mirrors age_mover's cfg_default: one KEY="VALUE" line replaces every KEY line
    cfg_default() {
        sed -i "/^$1=/d" "$config_file"
        [ -n "$(tail -c 1 "$config_file")" ] && echo >>"$config_file"
        echo "$1=\"$2\"" >>"$config_file"
    }

    if [[ ! -f "$config_file" ]]; then
        mvlogger "Error: Config file '$config_file' not found."
        return 1
    fi

    ## [[ ! "$config_file" =~ shareOverrideConfig ]] ensure that we are not reading share custom settings

    if [ -z "$(cfg enableTurbo)" ]; then
        if [[ ! "$config_file" =~ shareOverrideConfig ]]; then
            mvlogger "No Turbo Mode argument provided, defaulting to no"
            ENABLETURBO="no"
            cfg_default enableTurbo no
        fi
    else
        ENABLETURBO=$(cfg enableTurbo)
        [ "$ENABLETURBO" = "yes" ] && mvlogger "Enable Turbo: $ENABLETURBO"
    fi

    if [ -z "$(cfg testmode)" ]; then
        if [[ ! "$config_file" =~ shareOverrideConfig ]]; then
            mvlogger "No Test Mode argument provided, defaulting to yes"
            # yes for this run only: written to the global cfg it would put the scheduled mover in test mode too
            TESTMODE="yes"
        fi
    else
        TESTMODE=$(cfg testmode)
        [ "$TESTMODE" = "yes" ] && mvlogger "Test Mode: $TESTMODE"
    fi

}

if [ -f $UNRAIDCFGFILE ]; then
    if ! grep -qs 'shareCacheEnabled="yes"' $UNRAIDCFGFILE; then
        mvlogger "cache not enabled"
        exit 2
    fi
    if grep -qs 'shareMoverLogging="yes"' $UNRAIDCFGFILE; then
        LOGLEVEL=1
        mvlogger "Log Level: $LOGLEVEL"
    fi
fi

[ ! -f "$MOVERTUNINGCFGFILE" ] || mvlogger "$(titleLine "Mover Tuning Plugin version $(grep "version=" "$MOVERTUNINGCFGFILE" | cut -d '"' -f 2)" '*')"

#Test input variables
if [ -z "$1" ]; then
    mvlogger "No Share Argument Supplied"
    exit 2
else
    SHARENAME=$1
    SHARECFG="/boot/config/shares/${SHARENAME}.cfg"
fi

pid=$(head -n 1 "$PIDFILE" 2>/dev/null | tr -cd '0-9')
# shellcheck disable=SC2009 # pgrep -f would match any mover, not only this pid
if [ -n "$pid" ] && ps h "$pid" | grep -q mover; then
    mvlogger "already running"
    exit 1
fi

# Only start if config OK
if [ -f $UNRAIDCFGFILE ]; then
    if grep -qs 'shareMoverLogging="yes"' $UNRAIDCFGFILE; then
        mvlogger "Log Level: $LOGLEVEL"
    fi
else
    mvlogger "Fatal error: $UNRAIDCFGFILE does not exist, check this."
    exit 2
fi
if [ -f $MOVERTUNINGCFGFILE ]; then
    #Get Mover Tuning Settings
    mvlogger "$(titleLine "Global settings" '-')"
    getMoverSettings $MOVERTUNINGCFGFILE
else
    mvlogger "Fatal error: $MOVERTUNINGCFGFILE does not exist, check this."
    exit 3
fi

shopt -s nullglob
POOLCFGS=(/boot/config/pools/*.cfg)
# Only start if cache enabled and present
if ! grep -qs 'shareCacheEnabled="yes"' $UNRAIDCFGFILE && [ ${#POOLCFGS[@]} -lt 2 ]; then
    mvlogger "Fatal error: cache not enabled and less than 2 pools set up."
    exit 4
fi
if ! mountpoint -q /mnt/user0 && [ ${#POOLCFGS[@]} -lt 2 ]; then
    mvlogger "Fatal error: cache not present, or only cache present, and less than 2 pools set up."
    exit 5
fi

# Remove the pid file only while it still names this run, so overlapping runs cannot delete each other's
# shellcheck disable=SC2329 # the EXIT traps call it
pid_cleanup() {
    [ "$(cat "$PIDFILE" 2>/dev/null)" = "$$" ] && rm -f "$PIDFILE"
}

# Prints the write method var.ini gives when it is one mdcmd can set back: 0, 1 or auto, as mover.php checks
write_method() {
    local m
    m=$(grep -s '^md_write_method=' /var/local/emhttp/var.ini | cut -d'"' -f2)
    case $m in 0 | 1 | auto) echo "$m" ;; *) return 1 ;; esac
}

# With Turbo Mode on, forces turbo write for the moves, only when the write method can be set back after
force_turbo() {
    TURBO_WAS=""
    [ "$ENABLETURBO" = "yes" ] || return 0
    if ! TURBO_WAS=$(write_method); then
        mvlogger "Not forcing turbo write on: /var/local/emhttp/var.ini gives no write method (0, 1 or auto) to set back after"
        return 0
    fi
    if [ "$TESTMODE" = "yes" ]; then
        mvlogger "TEST MODE: Would force turbo write on"
        return 0
    fi
    # set first: a stop that ends the run from here on tries once to put the write method back before the pid file goes,
    # and a second stop waits for that try; a KILL cannot
    trap 'trap "" HUP INT TERM; restore_turbo; pid_cleanup' EXIT
    mvlogger "Forcing turbo write on"
    /usr/local/sbin/mdcmd set md_write_method 1 || mvlogger "Could not force turbo write on: mdcmd exited $?"
}

# Sets the write method back after force_turbo, where the moves end or from the EXIT trap of a run a signal ends sooner;
# the EXIT trap goes back to pid_cleanup alone, in a real run only once mdcmd has set it back
restore_turbo() {
    local m name
    [ -n "$TURBO_WAS" ] || return 0
    # var.ini's now, which Settings may have changed during the moves; the one read before when it gives none
    m=$(write_method) || m=$TURBO_WAS
    case $m in
    auto) name="Auto (read/modify/write)" ;;
    1) name="Turbo writes (Reconstruct)" ;;
    *) name="Read/modify/write" ;;
    esac
    if [ "$TESTMODE" = "yes" ]; then
        mvlogger "TEST MODE: Would restore original turbo write mode $name"
    else
        mvlogger "Restoring original turbo write mode $name"
        # the plugin's stop signals mdcmd before the run: one it ends first leaves the EXIT trap to try again
        /usr/local/sbin/mdcmd set md_write_method "$m" || {
            mvlogger "Could not restore original turbo write mode $name: mdcmd exited $?"
            return 1
        }
    fi
    TURBO_WAS=""
    trap pid_cleanup EXIT
}

trap pid_cleanup EXIT
trap 'exit 143' HUP INT TERM
echo $$ >"$PIDFILE"

mvlogger "$(titleLine "Processing $SHARENAME share" '-')"
if grep -qs 'shareUseCache="yes\|shareUseCache="prefer"' "$SHARECFG"; then
    mvlogger "Sharecfg: $SHARECFG"

    # Determine Cache mode
    SHAREUSECACHE=$(grep shareUseCache "$SHARECFG" | cut -d'=' -f 2 | tr -d '"' | tr -d '\r')

    # Determine primary storage
    PRIMARYSTORAGENAME=$(grep "shareCachePool=" "$SHARECFG" | cut -d'=' -f 2 | tr -d '"' | tr -d '\r')
    if [ -z "$PRIMARYSTORAGENAME" ]; then
        PRIMARYSTORAGENAME="user0"
    fi
    # Check if the storage exists
    if [ ! -d "/mnt/$PRIMARYSTORAGENAME" ]; then
        # Do not process this pool if path does not exist
        mvlogger "$(qp "/mnt/$PRIMARYSTORAGENAME") does not exist. Is the pool still used? Consider removing $SHARECFG if not."
        mvlogger "=> Skipping"
        exit
    fi

    # Determine secondary storage
    SECONDARYSTORAGENAME=$(grep "shareCachePool2=" "$SHARECFG" | cut -d'=' -f 2 | tr -d '"' | tr -d '\r')
    if [ -z "$SECONDARYSTORAGENAME" ]; then
        if [ "$SHAREUSECACHE" = "only" ] || [ "$SHAREUSECACHE" = "no" ]; then
            SECONDARYSTORAGENAME="none"
        else
            SECONDARYSTORAGENAME="user0"
        fi
    fi

    # Print pool info:
    mvlogger "Primary storage: $PRIMARYSTORAGENAME"
    mvlogger "Secondary storage: $SECONDARYSTORAGENAME"

    # Determine sharepath
    if [ "$SHAREUSECACHE" = "prefer" ]; then
        SHAREPATH="/mnt/$SECONDARYSTORAGENAME/$SHARENAME"
    else
        SHAREPATH="/mnt/$PRIMARYSTORAGENAME/$SHARENAME"
    fi

    mvlogger "Share Information: Name: $SHARENAME - Path: $SHAREPATH"
    if [ ! -d "$SHAREPATH" ]; then # && [ $SHAREUSECACHE != "no" ]
        # Do not process this pool if path does not exist
        mvlogger "$(qp "$SHAREPATH") does not exist or is empty."
        mvlogger "=> Skipping"
    else
        mvlogger "$(titleLine 'LET THE MOVING SHOW BEGIN !' '*')"

        # the share name reaches find only as an argument, never parsed as shell
        if [ "$SHAREUSECACHE" = "prefer" ]; then
            # "cache=prefer": the share's folder on each array disk and each other pool, never on a mount such as
            # Unassigned Devices' that only shares its name, for the move to the primary
            paths=()
            for dir in /mnt/disk[0-9] /mnt/disk[1-9][0-9] "${POOLCFGS[@]}"; do
                dir=/mnt/${dir##*/}
                dir=${dir%.cfg}
                if [ -d "$dir/$SHARENAME" ] && [ "$dir/$SHARENAME" != "/mnt/$PRIMARYSTORAGENAME/$SHARENAME" ]; then
                    paths+=("$dir/$SHARENAME")
                fi
            done
        else
            paths=("$SHAREPATH")
        fi
        FINDSTR="find"
        for p in "${paths[@]}"; do FINDSTR+=" $(qp "$p")"; done
        FINDSTR+=" -type f -depth"

        # find given no folder would list the one it runs in
        if [ ${#paths[@]} -eq 0 ]; then
            mvlogger "No array disk or other pool holds a folder of the share: nothing to move"
            mvlogger "=> Skipping"
        elif [ "$TESTMODE" = "yes" ]; then
            force_turbo
            mvlogger "Running in Test Mode: $FINDSTR"
            find "${paths[@]}" -type f -depth
            restore_turbo
        else
            MOVE=/usr/libexec/unraid/move
            [ -f "$MOVE" ] || MOVE=$(which move)
            force_turbo
            mvlogger "Complete Mover Command: $FINDSTR | $MOVE -d $LOGLEVEL"
            find "${paths[@]}" -type f -depth | "$MOVE" -d "$LOGLEVEL"
            st=("${PIPESTATUS[@]}")
            restore_turbo
            # move's own failure first: find's SIGPIPE follows from it
            MOVE_RC=$((st[1] ? st[1] : st[0]))
            [ "$MOVE_RC" = 0 ] || mvlogger "Move command failed: find exited ${st[0]}, move exited ${st[1]}"
        fi

    fi
fi

mvlogger "$(titleLine 'WE ARE DONE !' '*')"
[ "$LOGLEVEL" = 1 ] || echo "Mover tuning plugin done!"
exit "${MOVE_RC:-0}"
