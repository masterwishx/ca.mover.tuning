$.fn.toggleAttr = function(attr) {
  this.each(function() {
		var $this = $(this);
		$this.attr(attr) ? $this.removeAttr(attr) : $this.attr(attr,true);
	});
}

function toggleTime(source) {
  var $src = $('.' + source);
  var $dst = source === 'ctime' ? $('.atime') : $('.ctime');

  if ($src.val() === 'yes') {
    // Set opposite option to 'no'
    $dst.val('no');
  }
}

function toggleAge(val) {
  var enable = (val === 'yes');
  // enable or disable both CTIME and ATIME based on AGE
  $('.myage').prop('disabled', !enable);

  // re-apply mutual exclusivity if AGE is yes
  if (enable) {
    toggleTime('ctime');
    toggleTime('atime');
  }
}

